name: Day4 Frontend Check
on: push
 
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
 
      - name: Check templates
        run: |
          test -f templates/base.html || echo "FAIL: base.html"
          test -f templates/index.html || echo "FAIL: index.html"
          test -f templates/events.html || echo "FAIL: events.html"
          test -f templates/login.html || echo "FAIL: login.html"
          test -f templates/register.html || echo "FAIL: register.html"
          test -f templates/profile.html || echo "FAIL: profile.html"
 
      - name: Check static
        run: |
          test -f static/css/style.css || echo "FAIL: style.css"
          test -f static/js/main.js || echo "FAIL: main.js"
          SIZE_CSS=$(wc -c < static/css/style.css)
          SIZE_JS=$(wc -c < static/js/main.js)
          echo "style.css bytes: $SIZE_CSS (need >= 300)"
          echo "main.js bytes: $SIZE_JS (need >= 200)"
 
      - name: Check media queries in CSS
        run: |
          grep -q "@media" static/css/style.css \
            && echo "PASS: media queries found" \
            || echo "FAIL: no media queries"
 
      - name: Check showNotification in JS
        run: |
          grep -q "showNotification" static/js/main.js \
            && echo "PASS: showNotification found" \
            || echo "FAIL: no showNotification"
 
      - name: Check ARIA attributes in templates
        run: |
          grep -l "aria-label" templates/*.html \
            && echo "PASS: aria-label found" \
            || echo "FAIL: no aria-label"
          grep -l "role=" templates/*.html \
            && echo "PASS: role attribute found" \
            || echo "FAIL: no role attribute"
 
      - name: Check Dockerfile
        run: |
          grep -q "^FROM" Dockerfile \
            && echo "PASS: FROM found" \
            || echo "FAIL: no FROM"
          grep -q "^COPY" Dockerfile \
            && echo "PASS: COPY found" \
            || echo "FAIL: no COPY"
          grep -q "^CMD" Dockerfile \
            && echo "PASS: CMD found" \
            || echo "FAIL: no CMD"
 
      - name: Check docker-compose.yml
        run: |
          grep -q "services" docker-compose.yml \
            && echo "PASS: services found" \
            || echo "FAIL: no services"
          grep -q "postgres" docker-compose.yml \
            && echo "PASS: postgres found" \
            || echo "FAIL: no postgres"
 
      - name: Check .dockerignore
        run: |
          test -f .dockerignore \
            && echo "PASS: .dockerignore exists" \
            || echo "FAIL: no .dockerignore"
 
      - name: Syntax check app.py
        run: python -m py_compile app.py
 
      - run: echo "PASS: Day4 Frontend Check completed"
